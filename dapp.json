{
  "description": "Track daily habits and cheer each other on as a group",
  "icon": {
    "emoji": "🔥"
  },
  "secrets": [],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "Home shows the empty state for a new account",
      "path": "/",
      "expectText": "Start your first habit"
    },
    {
      "name": "Demo home renders the populated screen",
      "path": "/?demo=1",
      "expectText": "Staging demo",
      "id": "home-demo",
      "visual": true,
      "impact": ["public/**", "server.js", "styles/**"]
    },
    {
      "name": "Demo home shows the weekly leaderboard",
      "path": "/?demo=1",
      "expectText": "This week's leaderboard"
    },
    {
      "name": "Demo habits show their total check-ins",
      "path": "/?demo=1",
      "expectSelector": "#habits-list .total"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
